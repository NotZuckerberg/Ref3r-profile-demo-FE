# Railway's Postgres plugin sets DATABASE_URL automatically — you normally
# don't need to set anything. These are only for local development or if you
# split the API onto a different host than the frontend.

# Local Postgres connection string (Railway injects this in production)
# DATABASE_URL=postgresql://user:pass@localhost:5432/ref3r

# Admin password for the /admin page (create/edit/delete creators).
# REQUIRED for /admin to work — if unset, admin routes return 503.
# Set this in Railway → your service → Variables.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Only if the API runs on a DIFFERENT origin than the frontend.
# Leave unset when one Railway service serves both (the default here).
# VITE_API_BASE=https://your-api.up.railway.app
